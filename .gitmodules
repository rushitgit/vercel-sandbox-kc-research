[submodule "kc-ssrf-oidc"]
	path = kc-ssrf-oidc
	url = https://oidc.vercel.com/.well-known/jwks
[submodule "kc-ssrf-vsock"]
	path = kc-ssrf-vsock
	url = http://[::1]:23456/
